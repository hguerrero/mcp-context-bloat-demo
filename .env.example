# Copy to .env and fill in. scripts/env.sh loads it for every script.

# Solo Enterprise agentgateway license. toolMode (search, code, codeSearch) is an Enterprise feature.
AGENTGATEWAY_LICENSE_KEY=

# The gateway holds this key and adds it to the model calls.
ANTHROPIC_API_KEY=

# Read-only GitHub token for GitHub's hosted MCP server. If empty, the scripts use `gh auth token`.
GITHUB_PAT=

# Optional
# MODEL=claude-haiku-5-5
# REGISTRY_URL=http://localhost:12121
# GATEWAY_URL=http://localhost:3000
# HEADROOM_URL=http://localhost:8787
